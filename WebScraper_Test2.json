    {
      "parameters": {
        "jsCode": "return items.filter(item => {\n  const url = item.json.url || \"\";\n  const content = item.json.content || \"\";\n\n  return (\n    // ✅ valid URL\n    typeof url === \"string\" &&\n    url.startsWith(\"http\") &&\n\n    // ❌ avoid obvious non-article patterns\n    !url.match(/consent|login|signup|auth/i) &&\n    !url.match(/\\/video|\\/watch|\\/shorts/i) &&\n\n    // ❌ avoid empty or useless content\n    content &&\n    !content.match(/copyright|all rights reserved/i)\n  );\n});"
      },
